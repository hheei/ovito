#version 450
// Jump-flood outline path, stage 1/3: seeding.
// Replaces outlines_setup.comp when the JFA path is active.
//
// Every pixel adjacent to a qualifying depth edge becomes a seed carrying its
// pen size (the maximum over its four edges, computed with the same
// getPenSize() ramp as outlines_setup.comp). Seeds are written into the same
// uvec2 buffer the triangle path uses (no extra memory):
//
//   seed.x: packed seed pixel coordinates (y << 16 | x), 0xFFFFFFFF = no seed
//   seed.y: pen size in pixels (1..63)
//
// Buffer layout binding-compatible with outlines_setup.comp, so the C++ side
// reuses _setupSrb for this dispatch.

layout(local_size_x = 8, local_size_y = 8) in;

layout(std140, binding = 0) uniform Params {
    ivec2 size;
    vec2  depthRange;   // start, stop  (minDepthDiff, maxDepthDiff)
    vec2  widthRange;   // minSize, maxSize (minLineWidth, maxLineWidth)
    vec2  _pad;
    vec4  color;
    float nearPlane;
    float farPlane;
    int   isPerspective;
    int   _padDepthRange; // unused (was depthZeroToOne)
} P;

layout(std430, binding = 1) readonly  buffer DepthFixed { float depthFixed[]; };
layout(std430, binding = 2) writeonly buffer Seeds      { uvec2 seeds[]; };
// Per-pixel linearised depth of the frontmost ExcludeFromOutline surface (NO_EXCLUDED = none).
// A pixel whose excluded surface is in FRONT of its eligible surface neither seeds nor
// contributes an edge, so an excluded object in front creates no spurious outline — but one
// merely BEHIND the outlined geometry leaves the outline untouched.
layout(std430, binding = 3) readonly  buffer ExclDepth  { float exclDepth[];  };

const uint  INVALID_SEED = 0xFFFFFFFFu;
const float MAX_WIDTH     = 63.0;
const float NO_EXCLUDED  = 1.0e30;

// The seed's y-component stores the outline's HALF-width (reach from the silhouette edge, in
// pixels) as a fixed-point value with 1/REACH_SCALE-pixel resolution, so sub-pixel and fractional
// widths are supported. Using the half-width means the outline is centred on the edge and its total
// visible thickness equals the requested width: e.g. width 1 -> half-width 0.5 -> the two pixels
// straddling the edge each get ~50% coverage, i.e. a crisp 1-pixel line.
const float REACH_SCALE  = 256.0;

// depthFixed is the COMPOSITED depth = min(eligible, excluded), so exclDepth[i] >= depthFixed[i]
// always. Equality means the excluded surface is the frontmost (it occludes the eligible one).
// The tolerance is an additive fraction of |depth| rather than a multiplicative factor so it stays
// on the correct (toward-far) side even when the linearised depth is negative — which happens under
// an orthographic projection whose near plane is negative; a multiplicative factor would flip sign.
bool excludedOccludes(int i)
{
    return exclDepth[i] <= depthFixed[i] + abs(depthFixed[i]) * 0.001;
}

// The excluded surface at neighbour n is in front of the eligible surface at centre c (whose
// composited depth equals its eligible depth, since c is not itself occluded when this is called).
bool excludedInFrontOf(int n, float centerDepth)
{
    return exclDepth[n] < centerDepth - abs(centerDepth) * 0.001;
}

// Returns the outline width (in pixels) for a depth step of the given magnitude: minWidth for a
// step at minDepthDiff ramping up to maxWidth at maxDepthDiff. Returns 0 below the threshold.
float getWidth(float value)
{
    float t = (value - P.depthRange.x) / (P.depthRange.y - P.depthRange.x);
    t = clamp(t, 0.0, 1.0);
    if(t <= 1e-3)
        return 0.0;
    return min(P.widthRange.x + t * (P.widthRange.y - P.widthRange.x), MAX_WIDTH);
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if(p.x >= P.size.x || p.y >= P.size.y)
        return;
    int idx = p.y * P.size.x + p.x;

    // A pixel whose excluded surface is frontmost never seeds an outline (an excluded object
    // in front of the eligible geometry must not receive an outline of its own).
    if(excludedOccludes(idx)) {
        seeds[idx] = uvec2(INVALID_SEED, 0u);
        return;
    }

    float centerDepth = depthFixed[idx];

    // Outline width = max over the four pixel edges.
    // An edge is skipped only when the neighbour's excluded surface is IN FRONT of this
    // pixel's eligible surface — an excluded object merely behind it still yields a silhouette.
    float width = 0.0;
    if(p.x - 1 >= 0 && !excludedInFrontOf(idx - 1, centerDepth))
        width = max(width, getWidth(abs(centerDepth - depthFixed[idx - 1])));
    if(p.x + 1 < P.size.x && !excludedInFrontOf(idx + 1, centerDepth))
        width = max(width, getWidth(abs(centerDepth - depthFixed[idx + 1])));
    if(p.y - 1 >= 0 && !excludedInFrontOf(idx - P.size.x, centerDepth))
        width = max(width, getWidth(abs(centerDepth - depthFixed[idx - P.size.x])));
    if(p.y + 1 < P.size.y && !excludedInFrontOf(idx + P.size.x, centerDepth))
        width = max(width, getWidth(abs(centerDepth - depthFixed[idx + P.size.x])));

    // Store the half-width (reach from the edge) as fixed-point in the seed's y-component.
    uint reachFixed = uint(width * 0.5 * REACH_SCALE + 0.5);
    seeds[idx] = (width > 0.0) ? uvec2((uint(p.y) << 16) | uint(p.x), reachFixed)
                               : uvec2(INVALID_SEED, 0u);
}
