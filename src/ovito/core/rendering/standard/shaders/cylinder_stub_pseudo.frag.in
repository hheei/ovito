// Generated pseudo-color fragment shader stub. Do not edit; see cylinder_stub_pseudo.frag.in and cylinder_variants.cmake.
// Surface: @SURFACE_SNIPPET@
// FragOut: @FRAGOUT_SNIPPET@
// The vertex shader passes a normalized scalar in color.r and a sentinel -1.0 in color.g.
// This stub applies the colormap transfer function per-fragment after surface interpolation.

#version 450
#extension GL_GOOGLE_include_directive : enable

#include "../../scene_params.glsl"
#include "../../cylinders_draw_params.glsl"
#include "../common.glsl"
#include "@SURFACE_SNIPPET@"
#include "@FRAGOUT_SNIPPET@"

layout(binding = 2) uniform sampler2D colorMap;

void main()
{
    SurfaceSample s = sampleSurface();
    // color.g < 0 is the sentinel set by vbo_visual_pseudo.glsl: color.r holds the
    // interpolated normalized scalar; apply the transfer function here so the lookup
    // happens after per-pixel interpolation, not per-endpoint in the vertex shader.
    if(s.color.g < 0.0) {
        float alpha = s.color.a;
        s.color = vec4(texture(colorMap, vec2(s.color.r, 0.5)).rgb, alpha);
    }
    gl_FragDepth = s.depth;
    writeOut(s);
}
