#version 450
// Port of SetupTrianglesKernel.
//
// 64-bit repack: shaders have no portable uint64 (no MSL support, HLSL needs
// SM6, GLES never), so the 8x7-bit step counts + 8 flags become a uvec2 with
// 6-bit step counts (max line width 63 px instead of 127):
//
//   tri.x: bits 0-7   flags (one per triangle, popcount = coverage)
//          bits 8-13  value 0     bits 14-19 value 1
//          bits 20-25 value 2     bits 26-31 value 3
//   tri.y: bits 0-5   value 4 ... bits 18-23 value 7
//
// Triangle layout per pixel (same as the CUDA comment):
//   +-------+
//   |0 /|\ 2|
//   | / | \ |
//   |/ 1|3 \|
//   |---X---|
//   |\ 7|5 /|
//   | \ | / |
//   |6 \|/ 4|
//   +-------+

layout(local_size_x = 8, local_size_y = 8) in;

layout(std140, binding = 0) uniform Params {
    ivec2 size;
    vec2  depthRange;   // start, stop  (minDepthDiff, maxDepthDiff)
    vec2  widthRange;   // minSize, maxSize (minLineWidth, maxLineWidth)
    vec2  _pad;
    vec4  color;
    float nearPlane;
    float farPlane;
    int   isPerspective;
    int   _padDepthRange; // unused (was depthZeroToOne)
} P;

layout(std430, binding = 1) readonly  buffer DepthFixed { float depthFixed[]; };
layout(std430, binding = 2) writeonly buffer Tri        { uvec2 tri[]; };
// Per-pixel linearised depth of the frontmost ExcludeFromOutline surface (NO_EXCLUDED = none).
// A pixel whose excluded surface is frontmost emits no triangles, and an edge is skipped only
// when the neighbour's excluded surface is in FRONT of this pixel's eligible surface.
layout(std430, binding = 3) readonly  buffer ExclDepth  { float exclDepth[];  };

const uint  VAL_MASK    = 63u;
const float NO_EXCLUDED = 1.0e30;

// depthFixed is the COMPOSITED depth = min(eligible, excluded), so exclDepth[i] >= depthFixed[i];
// equality means the excluded surface is the frontmost (it occludes the eligible one). The tolerance
// is an additive fraction of |depth| (not a multiplicative factor) so it stays on the correct side
// even when the linearised depth is negative (orthographic projection with a negative near plane).
bool excludedOccludes(int i) { return exclDepth[i] <= depthFixed[i] + abs(depthFixed[i]) * 0.001; }
bool excludedInFrontOf(int n, float centerDepth) { return exclDepth[n] < centerDepth - abs(centerDepth) * 0.001; }

uint triGetVal(uvec2 t, uint i)
{
    return (i < 4u) ? ((t.x >> (8u + i * 6u)) & VAL_MASK)
                    : ((t.y >> ((i - 4u) * 6u)) & VAL_MASK);
}

uvec2 triSetVal(uvec2 t, uint i, uint v)
{
    v &= VAL_MASK;
    if(i < 4u) {
        uint s = 8u + i * 6u;
        t.x = (t.x & ~(VAL_MASK << s)) | (v << s);
    } else {
        uint s = (i - 4u) * 6u;
        t.y = (t.y & ~(VAL_MASK << s)) | (v << s);
    }
    return t;
}

uvec2 triSetFlag(uvec2 t, uint i) { t.x |= (1u << i); return t; }

int getPenSize(float value)
{
    float t = (value - P.depthRange.x) / (P.depthRange.y - P.depthRange.x);
    t = clamp(t, 0.0, 1.0);
    if(t <= 1e-3)
        return 0;
    return min(int(floor(P.widthRange.x + t * (P.widthRange.y - P.widthRange.x))),
               int(VAL_MASK));
}

uvec2 mark(uvec2 t, uint i, uint pen)
{
    t = triSetFlag(t, i);
    t = triSetVal(t, i, max(triGetVal(t, i), pen));
    return t;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if(p.x >= P.size.x || p.y >= P.size.y)
        return;
    int idx = p.y * P.size.x + p.x;

    uvec2 t = uvec2(0u);

    // A pixel whose excluded surface is frontmost emits no outline triangles.
    if(excludedOccludes(idx)) {
        tri[idx] = t;
        return;
    }

    float centerDepth = depthFixed[idx];
    int pen;

    // An edge is skipped only when the neighbour's excluded surface is IN FRONT of this
    // pixel's eligible surface — an excluded object merely behind it still yields a silhouette.

    // Edge left -> triangles 0 and 6
    pen = (p.x - 1 >= 0 && !excludedInFrontOf(idx - 1, centerDepth)) ? getPenSize(abs(centerDepth - depthFixed[idx - 1])) : 0;
    if(pen > 0) { t = mark(t, 0u, uint(pen)); t = mark(t, 6u, uint(pen)); }

    // Edge right -> triangles 2 and 4
    pen = (p.x + 1 < P.size.x && !excludedInFrontOf(idx + 1, centerDepth)) ? getPenSize(abs(centerDepth - depthFixed[idx + 1])) : 0;
    if(pen > 0) { t = mark(t, 2u, uint(pen)); t = mark(t, 4u, uint(pen)); }

    // Edge y-1 -> triangles 4 and 6
    pen = (p.y - 1 >= 0 && !excludedInFrontOf(idx - P.size.x, centerDepth)) ? getPenSize(abs(centerDepth - depthFixed[idx - P.size.x])) : 0;
    if(pen > 0) { t = mark(t, 4u, uint(pen)); t = mark(t, 6u, uint(pen)); }

    // Edge y+1 -> triangles 0 and 2
    pen = (p.y + 1 < P.size.y && !excludedInFrontOf(idx + P.size.x, centerDepth)) ? getPenSize(abs(centerDepth - depthFixed[idx + P.size.x])) : 0;
    if(pen > 0) { t = mark(t, 0u, uint(pen)); t = mark(t, 2u, uint(pen)); }

    tri[idx] = t;
}
