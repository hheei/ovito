{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Development (RelWithDebInfo)",
            "description": "Standard development build with C++ unit tests enabled",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "OVITO_BUILD_CPP_TESTS": "ON",
                "OVITO_BUILD_APP": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build with C++ unit tests enabled",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "OVITO_BUILD_CPP_TESTS": "ON",
                "OVITO_BUILD_APP": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Optimized release build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "OVITO_BUILD_CPP_TESTS": "ON",
                "OVITO_BUILD_APP": "ON"
            }
        },
        {
            "name": "native",
            "displayName": "Native Host (.qt, Clang + mold + ccache)",
            "description": "Ultra-fast native build using Clang 18, mold linker, ccache and local Qt in .qt",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-native",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=mold",
                "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=mold",
                "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=mold",
                "CMAKE_PREFIX_PATH": "${sourceDir}/.qt/6.10.2/gcc_64",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_INSTALL_RPATH_USE_LINK_PATH": "ON",
                "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON",
                "OVITO_BUILD_CPP_TESTS": "ON",
                "OVITO_BUILD_APP": "ON"
            }
        },
        {
            "name": "native-gcc",
            "displayName": "Native Host (.qt, GCC + mold + ccache)",
            "description": "Native build using GCC, mold linker, ccache and local Qt in .qt",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-native-gcc",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=mold",
                "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=mold",
                "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=mold",
                "CMAKE_PREFIX_PATH": "${sourceDir}/.qt/6.10.2/gcc_64",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_INSTALL_RPATH_USE_LINK_PATH": "ON",
                "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON",
                "OVITO_BUILD_CPP_TESTS": "ON",
                "OVITO_BUILD_APP": "ON"
            }
        },
        {
            "name": "ci",
            "hidden": true,
            "displayName": "CI base",
            "description": "Common settings of every CI job: Ninja, Release, C++ tests and the Qt Quick frontend. Set OVITO_COMPILER_LAUNCHER=ccache to route the compiler through a cache; the workflows set the CCACHE_* variables that make the precompiled headers cacheable (docs/design/UI_TEST_ENV.md section 6.1).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER_LAUNCHER": "$env{OVITO_COMPILER_LAUNCHER}",
                "CMAKE_CXX_COMPILER_LAUNCHER": "$env{OVITO_COMPILER_LAUNCHER}",
                "OVITO_BUILD_CPP_TESTS": "ON",
                "OVITO_BUILD_APP": "ON",
                "OVITO_BUILD_QML_FRONTEND": "ON"
            }
        },
        {
            "name": "ci-frontend",
            "hidden": true,
            "displayName": "CI base: Qt Quick frontend only",
            "description": "The Qt Quick frontend and the plugins its smoke test exercises, without the QtWidgets application: 512 instead of 951 translation units. Mesh, Grid and Delaunay stay enabled because the Particles plugin depends on them, and StdMod depends on Mesh.",
            "inherits": "ci",
            "cacheVariables": {
                "OVITO_BUILD_APP": "OFF",
                "OVITO_BUILD_PLUGIN_CRYSTALANALYSIS": "OFF",
                "OVITO_BUILD_PLUGIN_CORRELATION": "OFF",
                "OVITO_BUILD_PLUGIN_VOROTOP": "OFF",
                "OVITO_BUILD_PLUGIN_GALAMOST": "OFF",
                "OVITO_BUILD_PLUGIN_OXDNA": "OFF"
            }
        },
        {
            "name": "native-frontend",
            "displayName": "Native Host, Qt Quick frontend only (.qt, Clang + mold + ccache)",
            "description": "The frontend scope (no QtWidgets application, 512 instead of 951 translation units, no C++ tests) with the local Qt in .qt and with debug info, for iterating on the Qt Quick frontend and the OvitoQmlSpike. It does not build the ovito executable - iterating on the product frontend needs the native preset.",
            "inherits": "ci-frontend",
            "binaryDir": "${sourceDir}/build-native-frontend",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=mold",
                "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=mold",
                "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=mold",
                "CMAKE_PREFIX_PATH": "${sourceDir}/.qt/6.10.2/gcc_64",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "OVITO_BUILD_CPP_TESTS": "OFF",
                "CMAKE_INSTALL_RPATH_USE_LINK_PATH": "ON",
                "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON"
            }
        },
        {
            "name": "ci-linux",
            "displayName": "CI: Linux x86_64",
            "description": "The Linux test job: the whole product, compiled with clang (measured on the full tree, clang needs 1459 s of compile work against 2570 s for gcc, and 143 s of wall time at -j16 against 233 s) and with -O2 instead of the -O3 of a release build, because nothing here measures performance.",
            "inherits": "ci",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG"
            }
        },
        {
            "name": "ci-macos",
            "displayName": "CI: macOS ARM64",
            "description": "The macOS test job: the frontend scope - its smoke test needs the spike executable, which lands in the same Ovito.app bundle directory either way - with the -O2 of the Linux job.",
            "inherits": "ci-frontend",
            "cacheVariables": {
                "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG"
            }
        },
        {
            "name": "ci-windows",
            "displayName": "CI: Windows AMD64",
            "description": "The Windows test job: the whole product with MSVC. No optimization-level override is needed - an MSVC Release build is already /O2, and replacing CMAKE_CXX_FLAGS_RELEASE would drop the /MD runtime flag that Qt requires.",
            "inherits": "ci"
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "native",
            "configurePreset": "native"
        },
        {
            "name": "native-gcc",
            "configurePreset": "native-gcc"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "ci-linux",
            "configurePreset": "ci-linux"
        },
        {
            "name": "ci-macos",
            "configurePreset": "ci-macos"
        },
        {
            "name": "ci-windows",
            "configurePreset": "ci-windows"
        },
        {
            "name": "native-frontend",
            "configurePreset": "native-frontend"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "native",
            "configurePreset": "native",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "QT_QPA_PLATFORM": "offscreen",
                "LD_LIBRARY_PATH": "${sourceDir}/.qt/6.10.2/gcc_64/lib:${sourceDir}/build-native/lib/ovito/plugins:${sourceDir}/build-native/lib/ovito:$ENV{LD_LIBRARY_PATH}"
            }
        },
        {
            "name": "native-gcc",
            "configurePreset": "native-gcc",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "QT_QPA_PLATFORM": "offscreen",
                "LD_LIBRARY_PATH": "${sourceDir}/.qt/6.10.2/gcc_64/lib:${sourceDir}/build-native-gcc/lib/ovito/plugins:${sourceDir}/build-native-gcc/lib/ovito:$ENV{LD_LIBRARY_PATH}"
            }
        },
        {
            "name": "cpp",
            "displayName": "Run C++ unit tests",
            "configurePreset": "default",
            "filter": {
                "include": {
                    "label": "cpp"
                }
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
